{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:team": "bun run src/db/migrate-team.ts",
    "test:team": "bun test tests/team.test.ts",
    "db:migrate:auth": "bun run src/db/migrate-auth.ts",
    "test:auth": "bun test tests/auth.test.ts"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0",
    "drizzle-kit": "^0.31.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
